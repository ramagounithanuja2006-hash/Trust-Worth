NODE_ENV=development
PORT=5000

# MongoDB — set MONGO_REQUIRED=true to crash on startup if DB is unavailable
MONGO_URI=mongodb://127.0.0.1:27017/visiontrust
MONGO_REQUIRED=false

# JWT — use a long random secret in production!
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File Uploads
UPLOAD_MAX_MB=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# External Services
AI_SERVICE_URL=http://localhost:8000
AI_INFERENCE_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ABI=
BLOCKCHAIN_RECORD_FUNCTION=recordEvidence

# Logging
LOG_LEVEL=info
